{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbed.dev/schemas/manifest.skill.schema.json",
  "title": "Skill manifest",
  "description": "ADR-001 §6.3. Thin by design: the SKILL.md lives in the runtime. A skill can only narrow the calling agent's capabilities, never widen them — and that narrowing is ADVISORY AT THE HOST, because Agentbed sees runtimes, not skills. It becomes a host boundary only if runtimes ever issue attenuated per-skill credentials.",
  "type": "object",
  "required": ["kind", "version", "name", "runtime_format"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "skill" },
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "runtime_format": { "enum": ["hermes-skill", "openclaw-skill"] },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "plugins": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "capabilities": { "$ref": "https://agentbed.dev/schemas/capabilities.schema.json" }
  }
}
