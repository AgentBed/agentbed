{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbed.dev/schemas/tool/tx.status.request.schema.json",
  "title": "tx.status request parameters",
  "description": "ADR-001 §5.1: read-only status for one transaction.",
  "type": "object",
  "required": ["tx_id"],
  "additionalProperties": false,
  "properties": {
    "tx_id": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-Z]{25}$"
    }
  }
}
