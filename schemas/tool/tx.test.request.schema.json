{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbed.dev/schemas/tool/tx.test.request.schema.json",
  "title": "tx.test request parameters",
  "description": "effects.md §3: run the test activation for an existing staged transaction.",
  "type": "object",
  "required": ["tx_id"],
  "additionalProperties": false,
  "properties": {
    "tx_id": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-Z]{25}$"
    }
  }
}
