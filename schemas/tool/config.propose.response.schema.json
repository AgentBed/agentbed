{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbed.dev/schemas/tool/config.propose.response.schema.json",
  "title": "config.propose result",
  "description": "ADR-001 §5.2 step 2: human-readable diff, test plan, affected resources, and captured base revision.",
  "type": "object",
  "required": ["tx_id", "diff", "test_plan", "affected_resources", "base_revision"],
  "additionalProperties": false,
  "properties": {
    "tx_id": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-Z]{25}$"
    },
    "diff": { "type": "string" },
    "test_plan": {
      "type": "object",
      "required": ["adapter", "steps"],
      "additionalProperties": false,
      "properties": {
        "adapter": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "affected_resources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "base_revision": {
      "type": "object",
      "required": ["etc_git_commit", "config_digest"],
      "additionalProperties": false,
      "properties": {
        "generation": { "type": ["string", "null"] },
        "etc_git_commit": { "type": "string" },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
