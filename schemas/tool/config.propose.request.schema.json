{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbed.dev/schemas/tool/config.propose.request.schema.json",
  "title": "config.propose request parameters",
  "description": "ADR-001 §5.1 / effects.md §3: stage a declarative change set with an idempotency key. Gate 1 Nix hosts accept absolute paths under manifest-allowed write roots; semantic path enforcement is broker-side.",
  "type": "object",
  "required": ["idempotency_key", "changes"],
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/"
          },
          "content": { "type": "string" }
        }
      }
    }
  }
}
